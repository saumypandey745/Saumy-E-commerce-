# ============================================================================
# Production Environment Variables Template
# E-Commerce Enterprise Platform — Free Cloud Deployment
# ============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file: cp .env.production.example .env.production
# 2. Fill in ALL values marked with <REQUIRED>
# 3. Values marked with <GENERATED> should use: openssl rand -hex 32
#
# ============================================================================

# =========================================================================
# 🔐 JWT Secret (MUST be same across ALL services)
# =========================================================================
JWT_SECRET=<GENERATED: openssl rand -hex 64>

# =========================================================================
# 📦 MongoDB Atlas (M0 Free Tier)
# =========================================================================
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI_PRODUCTS=<REQUIRED: MongoDB Atlas connection string for products>
MONGO_URI_CART=<REQUIRED: MongoDB Atlas connection string for cart>
MONGO_URI_REVIEWS=<REQUIRED: MongoDB Atlas connection string for reviews>
MONGO_URI_MONITORING=<REQUIRED: MongoDB Atlas connection string for monitoring>

# =========================================================================
# 🐘 Neon PostgreSQL (Free Tier)
# =========================================================================
# Format: postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
DATABASE_URL_AUTH=<REQUIRED: Neon connection string for auth_db>
DATABASE_URL_ORDER=<REQUIRED: Neon connection string for order_db>
DATABASE_URL_PAYMENT=<REQUIRED: Neon connection string for payment_db>

# =========================================================================
# ⚡ Upstash Redis (Free Tier)
# =========================================================================
# Format: rediss://<token>@<host>.upstash.io:6379
REDIS_URL=<REQUIRED: Upstash Redis connection URL>

# =========================================================================
# 🐰 CloudAMQP RabbitMQ (Little Lemur Free)
# =========================================================================
# Format: amqps://<user>:<password>@<host>/<vhost>
RABBITMQ_URL=<REQUIRED: CloudAMQP connection URL>

# =========================================================================
# 💳 Stripe (Test Mode)
# =========================================================================
STRIPE_SECRET_KEY=sk_test_mock123

# =========================================================================
# 🔑 Google OAuth
# =========================================================================
GOOGLE_CLIENT_ID=<OPTIONAL: Google OAuth Client ID>

# =========================================================================
# 🌐 Production URLs (filled after Render deployment)
# =========================================================================
API_GATEWAY_URL=https://ecommerce-api-gateway.onrender.com
AUTH_SERVICE_URL=https://ecommerce-auth-service.onrender.com
PRODUCT_SERVICE_URL=https://ecommerce-product-service.onrender.com
ORDER_SERVICE_URL=https://ecommerce-order-service.onrender.com
PAYMENT_SERVICE_URL=https://ecommerce-payment-service.onrender.com
CART_SERVICE_URL=https://ecommerce-cart-service.onrender.com
SEARCH_SERVICE_URL=https://ecommerce-search-service.onrender.com
REVIEW_SERVICE_URL=https://ecommerce-review-service.onrender.com
AI_SERVICE_URL=https://ecommerce-ai-service.onrender.com
AIML_SERVICE_URL=https://ecommerce-ai-ml-service.onrender.com
MONITORING_SERVICE_URL=https://ecommerce-monitoring-service.onrender.com

# =========================================================================
# 🌐 Frontend URLs (filled after Vercel deployment)
# =========================================================================
STOREFRONT_URL=https://<storefront-project>.vercel.app
ADMIN_URL=https://<admin-project>.vercel.app
SELLER_URL=https://<seller-project>.vercel.app

# =========================================================================
# 🔒 CORS Allowed Origins
# =========================================================================
ALLOWED_ORIGINS=https://<storefront>.vercel.app,https://<admin>.vercel.app,https://<seller>.vercel.app
